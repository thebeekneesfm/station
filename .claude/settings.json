{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr review:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(gh auth:*)",
      "Bash(gh secret:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push)",
      "PowerShell(git push)",
      "Bash(git push origin HEAD)",
      "PowerShell(git push origin HEAD)",
      "Bash(git push -u origin HEAD)",
      "PowerShell(git push -u origin HEAD)"
    ],
    "defaultMode": "acceptEdits",
    "allow": [
      "WebSearch",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check.py"
            ],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
